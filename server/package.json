{
  "name": "mdr-server",
  "private": true,
  "type": "module",
  "description": "Serveur temps réel du jeu MDR (Cloudflare Worker + Durable Objects)",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "test": "node --test test/engine.test.mjs test/content.test.mjs",
    "test:e2e": "node --test test/e2e.test.mjs",
    "content": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --check"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
